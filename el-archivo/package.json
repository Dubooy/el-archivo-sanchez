{
  "name": "el-archivo",
  "version": "0.1.0",
  "private": true,
  "description": "EL ARCHIVO — plataforma documental y comunitaria. MVP con datos de demostración.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:sql": "tsx prisma/aplicar-sql.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:setup": "npm run db:migrate && npm run db:sql && npm run db:seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "prisma": "^7.10.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.7.3"
  }
}
